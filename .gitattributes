# Normalize source and Unity text files without touching binary assets.
* text=auto
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.ogg binary
.githooks/* text eol=lf
